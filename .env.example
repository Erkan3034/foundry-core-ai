# Foundry RAG Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Model Configuration
EMBEDDING_MODEL_ALIAS=qwen3-embedding-0.6b
# Instruct model onerilir (think blogu uretmez, Turkce kalitesi daha iyi):
CHAT_MODEL_ALIAS=qwen2.5-1.5b
# Daha hizli ama zayif alternatif: CHAT_MODEL_ALIAS=qwen2.5-0.5b
# Daha kaliteli ama agir alternatif (daha fazla RAM/VRAM ister): CHAT_MODEL_ALIAS=phi-4-mini

# Cihaz secimi: "auto" varsayilan varyanti secer; "generic-cpu" / "cuda-gpu"
# gibi bir deger id'sinde bu ifadeyi iceren varyanti secer.
# Dusuk VRAM'li sistemlerde (2 GB) iki model ayni anda GPU'ya sigmaz;
# embedding'i CPU'da tutmak chat modeline yer acar. Bkz. docs/adr/0003.
EMBEDDING_DEVICE=generic-cpu
CHAT_DEVICE=auto

# Database
DATABASE_PATH=knowledge_base.db

# Application
APP_NAME=foundry-rag-assistant
LOG_LEVEL=info

# Web Server
# Guvenlik: yalnizca yerel erisim icin 127.0.0.1; ag erisimi gerekiyorsa 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000

# RAG Configuration
TOP_K_RETRIEVAL=3
# Bu esigin altindaki benzerlik skorlari "belgelerde yok" sayilir (0-1 arasi)
MIN_SIMILARITY=0.35
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_LENGTH=4000

# Hibrit arama (dense embedding + BM25 anahtar kelime)
USE_HYBRID_SEARCH=true
HYBRID_POOL_FACTOR=5
KEYWORD_RESCUE_RATIO=0.75

# LLM ornekleme
# LLM yanit uzunlugu ust limiti
MAX_TOKENS=1024
TEMPERATURE=0.35
# Tekrar cezasi. 0 = kapali (parametre hic gonderilmez), 0.4+ = ciktiyi bozar.
# Tekrar donguleri artik rag_engine icindeki deterministik loop-guard ile
# yakalandigi icin varsayilan kapali; ornekleme ayarina bagimli degiliz.
FREQUENCY_PENALTY=0.0

# Kimlik dogrulama (bilgi tabanindan ayri dosya; /reset hesaplari silmez)
AUTH_DB_PATH=auth.db
SESSION_TTL_HOURS=12
# Farkli bir origin'den erisim gerekirse virgulle ayrilmis liste
CORS_ORIGINS=

# Optional: Custom model cache directory
MODEL_CACHE_DIR=./foundry_local_data/model_cache
